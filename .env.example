# Copy to .env and fill in what you need. Everything is optional.

# Port the server listens on
PORT=3000

# Public URL used in QR codes. Set this when deploying, or to your laptop's LAN IP
# (e.g. http://192.168.1.20:3000) so phones on the venue Wi-Fi can scan and join.
# If unset, Beacon auto-detects your LAN IP when you browse via localhost.
# PUBLIC_URL=

# Enables Claude-written icebreakers. Without it, Beacon uses template icebreakers.
# ANTHROPIC_API_KEY=
# BEACON_MODEL=claude-opus-5-5

# Minutes without an open app before an attendee is auto-checked-out
AUTO_CHECKOUT_MINUTES=45

# Where data is persisted
# DATA_FILE=./data/db.json

# Set to 1 to skip creating the DEMO24 demo event on startup
# DISABLE_DEMO=1
